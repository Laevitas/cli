// Cloudflare Worker config for cli.laevitas.ch.
//
// This is an "assets-only" Worker — no Worker script — that serves the
// static contents of ./site (index.html, install scripts, _redirects).
// Deployed by .github/workflows/deploy-site.yml on every push to main
// that touches site/**, install.{ps1,sh}, the workflow itself, or this
// file.
//
// The custom domain (cli.laevitas.ch) is configured in the Cloudflare
// dashboard and intentionally NOT declared here — leaving it out tells
// wrangler to preserve whatever is already attached, so deploys can't
// accidentally detach the domain.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cli",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
